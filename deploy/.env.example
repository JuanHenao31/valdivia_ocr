# Copia este archivo a .env y pon tus API keys reales.

# OpenAI (visión / OCR)
OPENAI_API_KEY=sk-...
OCR_MODEL=gpt-4o

# TypeSafe / Jev (clasificación + validación con confianza calibrada)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Umbrales para marcar celdas en amarillo (revisión humana)
OCR_CONF_THRESHOLD=70
JEV_SUPPORT_THRESHOLD=0.7

# CORS (lista separada por comas), opcional
CORS_ORIGINS=

# Modelos
OCR_MODEL_PLANILLAS=gpt-5.4-mini
PLANILLA_DOUBLE_READ=true
# Clasificación del webhook: lectura barata del encabezado cuando no hay caption/texto.
CLASSIFIER_MODEL=gpt-4o-mini

# Plátano ($/kg)
PLATANO_PRECIO_KG=1200
PLATANO_PRECIOS_CLIENTE=

# === WhatsApp (YCloud) — webhook https://excel.techapoli.com/webhooks/ycloud ===
YCLOUD_ENABLED=false
YCLOUD_API_KEY=
# Secreto whsec_ del endpoint en el dashboard de YCloud (firma HMAC del webhook).
YCLOUD_WEBHOOK_SECRET=
# Número del negocio en E.164 (from de salida y filtro de mensajes de otros números).
YCLOUD_WHATSAPP_FROM=
# Base pública para los enlaces de descarga del Excel que se mandan por WhatsApp.
PUBLIC_BASE_URL=https://excel.techapoli.com
# python -c "import secrets; print(secrets.token_urlsafe(32))"
DOWNLOAD_URL_SECRET=
DOWNLOAD_TTL_MINUTES=10080
