# =====================================================================================
#  OCR Excel — Valdivia. Copia este archivo a .env (local) o a /opt/ocr-excel/.env (VPS).
#  [OBLIGATORIA] = sin ella el servicio no funciona en producción.
#  [OPCIONAL]    = tiene un valor por defecto razonable; solo cámbiala si lo necesitas.
# =====================================================================================

# === App ===
# [OPCIONAL] Nombre que muestra /docs.
APP_NAME=TechApoli OCR Liquidaciones
# [OPCIONAL] true solo en desarrollo.
DEBUG=false
# [OPCIONAL] Orígenes CORS separados por coma (solo si un front web llama a /api/v1).
CORS_ORIGINS=

# === OpenAI (OCR con visión) ===
# [OBLIGATORIA] platform.openai.com -> API keys.
OPENAI_API_KEY=sk-...
# [OPCIONAL] Proceso 2 (remisiones/liquidaciones). gpt-4o es estable con temperature=0.
OCR_MODEL=gpt-4o
# [OPCIONAL] Proceso 1 (planillas manuscritas). Vacío = usa OCR_MODEL.
OCR_MODEL_PLANILLAS=gpt-5.4-mini
# [OPCIONAL] Leer cada planilla 2 veces y marcar en amarillo lo que no coincida.
PLANILLA_DOUBLE_READ=true
# [OPCIONAL] Modelo barato para leer el encabezado y clasificar documentos del webhook.
CLASSIFIER_MODEL=gpt-4o-mini
# [OPCIONAL] Páginas de cada PDF que se mandan al OCR (Gramaluz trae 9; los datos están en 1–2).
MAX_PDF_PAGES=3

# === TypeSafe / Jev (validación y clasificación con confianza calibrada) ===
# [OPCIONAL] Vacío = se trabaja sin Jev (solo la confianza del OCR y las reglas).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# === Umbrales de revisión humana (celdas amarillas) ===
# [OPCIONAL] 0–100: confianza del OCR por debajo de la cual la celda queda amarilla.
OCR_CONF_THRESHOLD=70
# [OPCIONAL] 0–100: similitud con el diccionario de labores. >= OK se corrige sin amarillo;
# >= REVIEW se corrige pero queda amarilla; menor se deja lo leído en amarillo.
LABOR_MATCH_OK=90
LABOR_MATCH_REVIEW=75
# [OPCIONAL] 0–1: confianza de Jev mínima (validar campos y aceptar su clasificación).
JEV_SUPPORT_THRESHOLD=0.7
# [OPCIONAL] Diferencia relativa de kg remisión vs liquidación que se señala (0.05 = 5%).
KG_DIFF_TOLERANCE=0.05

# === Plantilla Excel (Proceso 2) ===
# [OPCIONAL] Ya viene dentro de la imagen; no cambiar salvo plantilla nueva.
TEMPLATE_PATH=docs/Plantillas Liquidaciones de Fruta.xlsx
SHEET_NAME=Plantilla Limón
SHEET_NAME_PLATANO=Plantilla Normal

# === Precio plátano ($/kg) ===
# [OBLIGATORIA para plátano] Las remisiones/báscula no traen precio. Vacío = celda amarilla.
PLATANO_PRECIO_KG=1200
# [OPCIONAL] Precio por cliente, tiene prioridad: "CUATRO CIELOS=1200;OTRO=1100".
PLATANO_PRECIOS_CLIENTE=

# === WhatsApp (YCloud) — webhook https://excel.techapoli.com/webhooks/ycloud ===
# [OBLIGATORIA] true para atender el webhook (false = responde 200 y no procesa nada).
YCLOUD_ENABLED=false
# [OBLIGATORIA] YCloud -> Developers -> API Keys.
YCLOUD_API_KEY=
# [OBLIGATORIA] YCloud -> Developers -> Webhooks -> endpoint de arriba -> secreto whsec_...
#               (evento: whatsapp.inbound_message.received). Sin él se rechaza todo con 403.
YCLOUD_WEBHOOK_SECRET=
# [OBLIGATORIA] Número de WhatsApp de Valdivia en E.164 (+57...). Es el remitente de las
#               respuestas y filtra mensajes dirigidos a otros números de la cuenta.
YCLOUD_WHATSAPP_FROM=
# [OPCIONAL] Timeout (s) de las llamadas a YCloud.
MESSAGING_TIMEOUT_SECONDS=30

# === Entrega del Excel por WhatsApp (enlace de descarga firmado) ===
# [OBLIGATORIA] URL pública del servicio: WhatsApp descarga el .xlsx desde aquí.
PUBLIC_BASE_URL=https://excel.techapoli.com
# [OBLIGATORIA] Secreto para firmar los enlaces. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DOWNLOAD_URL_SECRET=
# [OPCIONAL] Vigencia del enlace en minutos (10080 = 7 días).
DOWNLOAD_TTL_MINUTES=10080
# [OPCIONAL] Carpeta de los Excel generados. En Docker ya viene /data/outputs (volumen).
# OUTPUTS_DIR=output/webhook
